{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uri-twin/uri-twin-catalog/blob/main/schemas/catalog.v1.schema.json",
  "title": "URI Twin organization catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "organization", "repositories"],
  "properties": {
    "schema": {"const": "uri-twin.catalog/v1"},
    "version": {"const": 1},
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+$"}
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family", "role", "repository", "default_ref", "package", "latest_tag", "baseline", "supported_schemas"],
        "properties": {
          "id": {"type": "string", "pattern": "^uri-twin-[a-z0-9-]+$"},
          "family": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "role": {"enum": ["contracts", "platform-twin"]},
          "repository": {"type": "string", "pattern": "^https://github\\.com/uri-twin/uri-twin-[a-z0-9-]+\\.git$"},
          "default_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
          "package": {"type": "string", "pattern": "^@uri-twin/[a-z0-9-]+$"},
          "latest_tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "baseline": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "schema"],
                "properties": {
                  "path": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"},
                  "schema": {"type": "string", "pattern": "^[a-z0-9.-]+/[vV][0-9]+$"}
                }
              }
            ]
          },
          "supported_schemas": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9.-]+/[vV][0-9]+$"}
          }
        }
      }
    }
  }
}
